@page "/"
@page "/{Class}"
@using JLPTWordbook.Services
@using JLPTWordbook.Shared
@inject Worksheet Sheet
@inject JwtAuthenticationStateProvider Auth
@inject WordbookDatabaseService Wdb
@inject IJSRuntime JS

<div class="tab">
    <ul class="tabnav">
        @foreach (var name in Enum.GetNames<Worksheet.Class>())
        {
            <li class="@(IsActiveTab(name) ? "active" : "")">
                <a href="@name.ToLower()">@name</a>
            </li>
        }
    </ul>
    <div class="tabcontent">
        <div class="view-mode-toggle">
            <button class="@(m_ViewMode == ViewMode.Study ? "btn-mode active" : "btn-mode")" @onclick="() => SetViewMode(ViewMode.Study)">
                <span class="material-symbols-outlined">school</span>
                <span>@Strings.WORDBOOK_VIEW_STUDY</span>
            </button>
            <button class="@(m_ViewMode == ViewMode.List ? "btn-mode active" : "btn-mode")" @onclick="() => SetViewMode(ViewMode.List)">
                <span class="material-symbols-outlined">list</span>
                <span>@Strings.WORDBOOK_VIEW_LIST</span>
            </button>
        </div>

        @if (m_ViewMode == ViewMode.Study)
        {
            @if (m_Book != null && m_Current != -1)
            {
                @if (Auth.IsAuthorized)
                {
                    var total = m_Book.Words.Count;
                    var remaining = total - m_MemorizedIndices.Count;
                    var progressPct = total > 0 ? (int)((double)(total - remaining) / total * 100) : 0;

                    <div class="wordbook-progress">
                        <span class="progress-text">@string.Format(Strings.WORDBOOK_PROGRESS, remaining, total)</span>
                        <div class="progress-bar-track">
                            <div class="progress-bar-fill" style="width: @(progressPct)%"></div>
                        </div>
                    </div>
                }

                <div class="component-view">
                    <ruby>
                        @foreach (var component in m_Book.Words[m_Current].Components)
                        {
                            @component.Text
                            <rt>@component.Reading</rt>
                        }
                    </ruby>
                </div>
                <p class="localizer-view">@m_Book.Words[m_Current].Localizer()</p>

                <div class="wordbook-actions">
                    @if (Auth.IsAuthorized)
                    {
                        <button class="btn-memorized" @onclick="MarkMemorized" disabled="@m_IsLoading">
                            <span class="material-symbols-outlined">check_circle</span>
                            <span>@Strings.WORDBOOK_MEMORIZED</span>
                        </button>
                    }
                    <button class="btn-next" @onclick="Refresh" disabled="@m_IsLoading">
                        <span class="material-symbols-outlined">arrow_forward</span>
                        <span>@Strings.WORDBOOK_NEXT</span>
                    </button>
                    @if (Auth.IsAuthorized && m_MemorizedIndices.Count > 0)
                    {
                        <button class="btn-reset" @onclick="ResetMemorized" disabled="@m_IsLoading">
                            <span class="material-symbols-outlined">restart_alt</span>
                            <span>@Strings.WORDBOOK_RESET</span>
                        </button>
                    }
                </div>

                @if (!Auth.IsAuthorized)
                {
                    <p class="login-hint">
                        <span class="material-symbols-outlined">info</span>
                        @Strings.WORDBOOK_LOGIN_HINT
                    </p>
                }
            }
            else if (HasMemorizedAllWords())
            {
                <div class="all-memorized-banner">
                    <span class="material-symbols-outlined all-memorized-icon">celebration</span>
                    <p>@Strings.WORDBOOK_ALL_MEMORIZED</p>
                    <div class="wordbook-actions">
                        <button class="btn-reset" @onclick="ResetMemorized" disabled="@m_IsLoading">
                            <span class="material-symbols-outlined">restart_alt</span>
                            <span>@Strings.WORDBOOK_RESET</span>
                        </button>
                    </div>
                </div>
            }
        }
        else
        {
            @* List mode *@
            <div class="wordlist-header">
                <input class="search-input" type="text" placeholder="@Strings.WORDBOOK_SEARCH_PLACEHOLDER"
                       @bind="m_SearchQuery" @bind:event="oninput" />
                @if (m_Book != null && Auth.IsAuthorized)
                {
                    <span class="list-stats">@string.Format(Strings.WORDBOOK_LIST_TOTAL, m_Book.Words.Count, m_MemorizedIndices.Count)</span>
                }
            </div>
            <div class="wordlist-container">
                @if (m_Book != null)
                {
                    <Virtualize Items="FilteredWords" Context="item" OverscanCount="20">
                        <div class="wordlist-item @(Auth.IsAuthorized && m_MemorizedIndices.Contains(item.Index) ? "memorized" : "")">
                            <span class="wordlist-japanese">
                                @string.Concat(item.Word.Components.Select(c => c.Text))
                            </span>
                            <span class="wordlist-reading">
                                (@string.Concat(item.Word.Components.Select(c => c.Reading)))
                            </span>
                            <span class="wordlist-meaning">@item.Word.Localizer()</span>
                            @if (Auth.IsAuthorized)
                            {
                                <span class="wordlist-memorized-badge @(m_MemorizedIndices.Contains(item.Index) ? "badge-memorized" : "badge-not-memorized")">
                                    @if (m_MemorizedIndices.Contains(item.Index))
                                    {
                                        <span class="material-symbols-outlined">check_circle</span>
                                    }
                                    else
                                    {
                                        <span class="material-symbols-outlined">radio_button_unchecked</span>
                                    }
                                </span>
                            }
                        </div>
                    </Virtualize>
                }
            </div>
        }
    </div>
</div>

@code {
    private enum ViewMode { Study, List }

    [Parameter]
    public string? Class { get; set; }

    private Wordbook? m_Book;
    private int m_Current = -1;
    private Worksheet.Class m_Class;
    private HashSet<int> m_MemorizedIndices = [];
    private bool m_IsLoading = false;
    private ViewMode m_ViewMode = ViewMode.Study;
    private string m_SearchQuery = string.Empty;

    private string ClassName => m_Class.ToString().ToLower();

    private record WordListItem(int Index, Word Word);

    private List<WordListItem> FilteredWords
    {
        get
        {
            if (m_Book == null) return [];
            var query = m_SearchQuery.Trim();
            IEnumerable<WordListItem> items = m_Book.Words
                .Select((word, i) => new WordListItem(i, word));
            if (!string.IsNullOrEmpty(query))
            {
                items = items.Where(item =>
                    item.Word.Ko.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    item.Word.En.Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    string.Concat(item.Word.Components.Select(c => c.Text)).Contains(query, StringComparison.OrdinalIgnoreCase) ||
                    string.Concat(item.Word.Components.Select(c => c.Reading)).Contains(query, StringComparison.OrdinalIgnoreCase));
            }
            return items.ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(Class) || Enum.TryParse<Worksheet.Class>(Class, true, out var klass) == false)
        {
            klass = Worksheet.Class.N5;
        }

        m_Book = Sheet[klass];
        m_Class = klass;
        m_MemorizedIndices = [];
        m_SearchQuery = string.Empty;

        if (Auth.IsAuthorized)
        {
            var sub = Auth.Sub;
            if (!string.IsNullOrEmpty(sub))
            {
                var indices = await Wdb.GetMemorizedWordIndicesAsync(sub, ClassName);
                m_MemorizedIndices = new HashSet<int>(indices);
            }
        }

        m_Current = PickRandomAvailableIndex();
    }

    private void SetViewMode(ViewMode mode)
    {
        m_ViewMode = mode;
        m_SearchQuery = string.Empty;
    }

    private bool IsActiveTab(string tabName)
    {
        return string.Equals(tabName, m_Class.ToString(), StringComparison.OrdinalIgnoreCase);
    }

    private bool HasMemorizedAllWords()
    {
        return m_Book != null && m_Book.Words.Count > 0
            && m_Current == -1
            && m_MemorizedIndices.Count == m_Book.Words.Count;
    }

    private void Refresh()
    {
        m_Current = PickRandomAvailableIndex(m_Current);
    }

    private async Task MarkMemorized()
    {
        if (m_Book == null || m_Current == -1 || m_IsLoading) return;

        var sub = Auth.Sub;
        if (string.IsNullOrEmpty(sub)) return;

        m_IsLoading = true;
        try
        {
            await Wdb.MarkWordAsMemorizedAsync(sub, ClassName, m_Current);
            m_MemorizedIndices.Add(m_Current);
            m_Current = PickRandomAvailableIndex();
        }
        finally
        {
            m_IsLoading = false;
        }
    }

    private async Task ResetMemorized()
    {
        if (m_IsLoading) return;

        var sub = Auth.Sub;
        if (string.IsNullOrEmpty(sub)) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm", string.Format(Strings.WORDBOOK_RESET_CONFIRM, m_Class.ToString()));
        if (!confirmed) return;

        m_IsLoading = true;
        try
        {
            await Wdb.ResetMemorizedWordsAsync(sub, ClassName);
            m_MemorizedIndices.Clear();
            m_Current = PickRandomAvailableIndex();
        }
        finally
        {
            m_IsLoading = false;
        }
    }

    private int PickRandomAvailableIndex(int excludeIndex = -1)
    {
        if (m_Book == null || m_Book.Words.Count == 0) return -1;

        var available = Enumerable.Range(0, m_Book.Words.Count)
            .Where(i => !m_MemorizedIndices.Contains(i))
            .ToList();

        if (available.Count == 0) return -1;

        if (available.Count > 1)
        {
            var nonCurrent = available.Where(i => i != excludeIndex).ToList();
            if (nonCurrent.Count > 0)
            {
                return nonCurrent[Random.Shared.Next(nonCurrent.Count)];
            }
        }

        return available[Random.Shared.Next(available.Count)];
    }
}
